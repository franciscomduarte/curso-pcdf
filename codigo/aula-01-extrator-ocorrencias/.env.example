# Copie para .env e preencha. NUNCA versione o .env com a chave real.
# Sem OPENAI_API_KEY, os laboratórios rodam com o MockExtrator (LLM falso, offline).
OPENAI_API_KEY=coloque_sua_chave_aqui

# Opcional: modelo usado pelo OpenAIExtrator.
# Consulte a documentação atual da OpenAI para o modelo recomendado.
OPENAI_MODEL=gpt-4.1-mini
